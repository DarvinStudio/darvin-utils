<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true">
    <php>
        <server name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
    </php>
    <testsuites>
        <testsuite name="darvin-utils">
            <directory>Tests</directory>
            <!-- TODO: ObjectNamer::name(null) throws TypeError on PHP 8 (tracked in STATUS.md as a separate breakage) -->
            <exclude>Tests/ObjectNamer</exclude>
        </testsuite>
    </testsuites>
</phpunit>
